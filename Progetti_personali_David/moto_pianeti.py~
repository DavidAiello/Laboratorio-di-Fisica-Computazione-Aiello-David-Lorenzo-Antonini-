import matplotlib.pyplot as plt
import numpy as np
t = []
x = []
y = []
vx = []
vy = []
periodi = []
def T(x,t):
    zeros = []
    periodi = []
    for i in range(len(x)-1):
        if x[i] * x[i+1] < 0:
            m = (x[i+1]- x[i]) / (t[i+1] - t[i])
            zeros.append(-(x[i] / m)+t[i])
    for j in range(len(zeros)):
        periodi.append(zeros[j]*2)
    return periodi

for i in range(10):
    ti,xi,yi,vxi,vyi = np.loadtxt(f"pianeti{i}.dat", unpack = True)
    t.append(ti)
    x.append(xi)
    y.append(yi)
    vx.append(vxi)
    vy.append(vyi)
    periodi.append(T(xi,ti))
media_periodi = []
for j in range(10):
    media_periodi.append(np.mean(periodi[j]))
    print(f"periodo_{j} = {media_periodi[j]}")
